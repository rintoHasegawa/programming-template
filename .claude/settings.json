{
  "permissions": {
    "allow": [
      "Bash(gh pr merge:*)"
    ]
  },
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit|Glob|Grep|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/restrict_repo_access.py"
          }
        ]
      }
    ]
  }
}
