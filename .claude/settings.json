{
  "permissions": {
    "allow": [
      "Bash(gh pr merge:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit|NotebookEdit|Glob|Grep|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_python.sh\" --fail-closed \"$CLAUDE_PROJECT_DIR/.claude/hooks/restrict_repo_access.py\""
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_python.sh\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/notify.py\"",
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog|elicitation_url_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_python.sh\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/notify.py\"",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_python.sh\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/notify.py\"",
            "async": true
          }
        ]
      }
    ]
  }
}
